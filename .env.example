# Database Connection (Use local connection string or your MongoDB Atlas URI)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/investease
MONGODB_URI=mongodb://127.0.0.1:27017/investease

# NextAuth Configuration (URL and cryptographically secure secret)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_32_character_string_here

# Google Gemini API Configuration (Optional: Chatbot will fallback locally if omitted)
GEMINI_API_KEY=your_google_gemini_api_key_here
